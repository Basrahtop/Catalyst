{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); const path = require('path'); const file = path.join(__dirname, 'dist', 'utils', 'payment-schedule.js'); if (!fs.existsSync(file)) { console.error('❌ payment-schedule.js not found after build!'); process.exit(1); } else { console.log('✅ payment-schedule.js exists in dist/utils'); }\"",
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "postinstall": "prisma generate",
    "oracle:start": "tsx src/cardano/services/oracle.runner.ts",
    "cardano:setup-multisig": "node src/cardano/scripts/create-multisig.mjs",
    "cardano:build-contracts": "cd ../aiken-contracts && aiken build && cd ../backend && node -e \"const fs=require('fs'); const src='../aiken-contracts/plutus.json'; const dest='src/cardano/plutus/reputation_registry.json'; fs.mkdirSync('src/cardano/plutus', {recursive:true}); fs.copyFileSync(src, dest); console.log('✅ Contracts compiled and copied');\"",
    "deploy:escrow:preprod": "tsx src/cardano/scripts/deploy-escrow.ts --network=Preprod",
    "deploy:escrow:mainnet": "tsx src/cardano/scripts/deploy-escrow.ts --network=Mainnet",
    "cardano:balance": "tsx -e \"import('./src/cardano/services/cardano-payment.service.js').then(m => m.cardanoPaymentService.getWalletBalance().then(b => console.log('ADA:', b.ada.toString(), 'lovelace\\nUSDM:', b.usdm.toString(), 'microUSDM\\nAddress:', b.address)))\"",
    "test:exchange-rate": "tsx src/tests/test-exchange-rate.ts",
    "test:exchange-rate:multi": "tsx src/tests/test-exchange-rate-multi-source.ts",
    "test:phase1": "tsx src/tests/test-phase1-integration.ts",
    "test:wallet-balance": "tsx src/tests/test-wallet-balance.ts",
    "test:db-schema": "npx prisma validate && echo '✅ Schema is valid'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@meshsdk/core": "^1.9.0-beta.90",
    "@meshsdk/react": "^1.9.0-beta.90",
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "datauri": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucid-cardano": "^0.10.7",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.3",
    "nodemon": "^3.1.10",
    "prisma": "^6.18.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
