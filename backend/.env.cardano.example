# Cardano Blockchain Integration

# Enable/disable Cardano features (set to 'true' to enable)
CARDANO_ENABLED=true

# Network: 'Preprod' for testing, 'Mainnet' for production
CARDANO_NETWORK=Preprod

# Blockfrost API Configuration
# Get your API key from: https://blockfrost.io/
# Preprod: https://cardano-preprod.blockfrost.io/api/v0
# Mainnet: https://cardano-mainnet.blockfrost.io/api/v0
BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
BLOCKFROST_API_KEY=preprod39l0NhDAV4JADjgkMXNkqfJooLhomXDR

# Multi-Signature Wallet Address (generated by npm run cardano:setup-multisig)
MULTISIG_ADDRESS=

# Admin Keys - NEVER COMMIT THESE TO VERSION CONTROL
# Store securely and distribute to 3 different trusted administrators
# Generated by: npm run cardano:setup-multisig
ADMIN1_PAYMENT_KEY=
ADMIN2_PAYMENT_KEY=
ADMIN3_PAYMENT_KEY=

# Oracle Service Configuration
# How often to update reputation scores (cron format: '0 0,12 * * *' = every 12 hours)
ORACLE_CRON_SCHEDULE=0 0,12 * * *

# $USDM Stablecoin Configuration (Mehen)
# Policy ID for $USDM token on Cardano
USDM_POLICY_ID=

# Optional: Webhook for transaction notifications
CARDANO_WEBHOOK_URL=
